{
  "$comment": "WorkBuddy manual setup — start pnpm dev:agent in BeatDesign, then merge this entry into ~/.workbuddy/mcp.json. For marketplace packaging, use integrations/workbuddy/beatdesign instead.",
  "mcpServers": {
    "beatdesign": {
      "type": "streamableHttp",
      "url": "http://127.0.0.1:3031/mcp",
      "timeout": 30000,
      "description": "BeatDesign local-first AI canvas (BeatAPI). Open http://127.0.0.1:3020 for the browser view."
    }
  }
}
