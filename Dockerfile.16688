FROM node:22-bookworm-slim AS builder

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.32.1 --activate

COPY . .
RUN corepack pnpm install --frozen-lockfile
RUN mkdir -p data && corepack pnpm db:push --force
RUN corepack pnpm build:16688

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3020

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/.output ./.output
COPY --from=builder /app/data ./seed-data

EXPOSE 3020

CMD ["sh", "-c", "if [ ! -s /app/data/local.db ] || [ \"$(stat -c %s /app/data/local.db 2>/dev/null || echo 0)\" -le 4096 ]; then cp -a /app/seed-data/. /app/data/; fi; exec node .output/server/index.mjs"]
